+					},
+					"restartPolicy": {
+						Type:        "string",
+						Enum:        []any{"Always", "OnFailure", "Never"},
+						Description: "Optional restart policy (default Always); use Never for a one-off command",
+					},
+					"replace": {
+						Type:        "boolean",
