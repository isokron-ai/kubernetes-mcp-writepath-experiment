diff --git a/pkg/mcp/argument_validation.go b/pkg/mcp/argument_validation.go
new file mode 100644
index 0000000..aa2ba44
--- /dev/null
+++ b/pkg/mcp/argument_validation.go
@@ -0,0 +1,57 @@
+package mcp
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/google/jsonschema-go/jsonschema"
+)
+
+// argumentValidator checks tool-call arguments against the tool's input schema before
+// the handler runs. The go-sdk's raw AddTool path does not, so a wrongly typed or
+// unknown argument used to reach the handler, which could drop it silently (a dryRun
+// argument that no tool has was ignored, and the write happened).
+//
+// Required arguments are left to the handlers, which already report them with their
+// own messages; everything else in the schema (types, enums, patterns, ranges, nested
+// objects) is enforced, and an argument the schema does not declare is refused.
+type argumentValidator struct {
+	resolved *jsonschema.Resolved
+	known    []string
+}
+
+func newArgumentValidator(schema *jsonschema.Schema) (*argumentValidator, error) {
+	clone := schema.CloneSchemas()
+	clone.Required = nil
+	resolved, err := clone.Resolve(nil)
+	if err != nil {
+		return nil, err
+	}
+	known := make([]string, 0, len(schema.Properties))
+	for name := range schema.Properties {
+		known = append(known, name)
+	}
+	slices.Sort(known)
+	return &argumentValidator{resolved: resolved, known: known}, nil
+}
+
+func (v *argumentValidator) validate(arguments map[string]any) error {
+	var unknown []string
+	for name := range arguments {
+		if !slices.Contains(v.known, name) {
+			unknown = append(unknown, name)
+		}
+	}
+	if len(unknown) > 0 {
+		slices.Sort(unknown)
+		return fmt.Errorf("unknown argument(s) %s; this tool accepts: %s", strings.Join(unknown, ", "), strings.Join(v.known, ", "))
+	}
+	if arguments == nil {
+		arguments = map[string]any{}
+	}
+	if err := v.resolved.Validate(arguments); err != nil {
+		return fmt.Errorf("invalid arguments: %w", err)
+	}
+	return nil
+}
diff --git a/pkg/mcp/argument_validation_test.go b/pkg/mcp/argument_validation_test.go
new file mode 100644
index 0000000..e7f9605
--- /dev/null
+++ b/pkg/mcp/argument_validation_test.go
@@ -0,0 +1,56 @@
+package mcp
+
+import (
+	"testing"
+
+	"github.com/modelcontextprotocol/go-sdk/mcp"
+	"github.com/stretchr/testify/suite"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/kubernetes"
+
+	"github.com/containers/kubernetes-mcp-server/internal/test"
+)
+
+type ArgumentValidationSuite struct {
+	BaseMcpSuite
+}
+
+func (s *ArgumentValidationSuite) TestUnknownArgumentIsRefusedBeforeAnyWrite() {
+	s.InitMcpClient()
+	result, err := s.CallTool("resources_create_or_update", map[string]interface{}{
+		"resource": "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: cm-dryrun-typo\n  namespace: default\n",
+		"dryRun":   true,
+	})
+	s.Require().NoError(err)
+	s.Run("returns an error naming the argument and the accepted ones", func() {
+		s.True(result.IsError)
+		text := result.Content[0].(*mcp.TextContent).Text
+		s.Contains(text, "unknown argument(s) dryRun")
+		s.Contains(text, "dry_run")
+	})
+	s.Run("writes nothing", func() {
+		_, getErr := kubernetes.NewForConfigOrDie(test.EnvTestRestConfig()).CoreV1().ConfigMaps("default").Get(s.T().Context(), "cm-dryrun-typo", metav1.GetOptions{})
+		s.True(apierrors.IsNotFound(getErr), "an ignored dryRun used to perform the real write")
+	})
+}
+
+func (s *ArgumentValidationSuite) TestWrongTypeIsRefused() {
+	s.InitMcpClient()
+	result, err := s.CallTool("pods_run", map[string]interface{}{"image": "nginx", "port": "80"})
+	s.Require().NoError(err)
+	s.True(result.IsError)
+	s.Contains(result.Content[0].(*mcp.TextContent).Text, "validating /properties/port: type")
+}
+
+func (s *ArgumentValidationSuite) TestRequiredArgumentsStillReportedByTheHandler() {
+	s.InitMcpClient()
+	result, err := s.CallTool("resources_create_or_update", map[string]interface{}{})
+	s.Require().NoError(err)
+	s.True(result.IsError)
+	s.Equal("failed to create or update resources, missing argument resource", result.Content[0].(*mcp.TextContent).Text)
+}
+
+func TestArgumentValidation(t *testing.T) {
+	suite.Run(t, new(ArgumentValidationSuite))
+}
