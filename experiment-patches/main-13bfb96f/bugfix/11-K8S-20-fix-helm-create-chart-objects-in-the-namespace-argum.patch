From bf95e341a22f8589d11a02e5613ae40df099a2aa Mon Sep 17 00:00:00 2001
From: Rafe Walker <45343084+rafe-walker@users.noreply.github.com>
Date: Wed, 11 Nov 2026 11:44:05 -0700
Subject: [PATCH 11/14] fix(helm): create chart objects in the namespace
 argument

helm_install passed its namespace argument to action.Configuration.Init,
which uses it only for the release storage. Helm's kube client, which
creates the chart's objects, falls back to the kubeconfig's namespace
for every object without metadata.namespace (Client.namespace()). So
`helm_install(namespace=X)` stored the release record in X but created
the chart's objects in the kubeconfig's namespace: with a kubeconfig
whose identity cannot write there the install failed with a 403 naming
the other namespace, and with one that can, the objects landed there
silently. `helm install -n X` puts both in X.

newAction now also sets the kube client's Namespace, as the Helm CLI
does from --namespace. helm_uninstall goes through the same function,
so it now deletes a release's namespace-less objects from the release's
namespace. A release installed before this fix, whose objects went to
the kubeconfig's namespace, leaves those objects behind on uninstall
(Helm skips objects it cannot find); they need removing by hand.
helm_list with all_namespaces is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg/helm/helm.go     | 16 ++++++++++++++--
 pkg/mcp/helm_test.go | 29 +++++++++++++++++++++++++++++
 2 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/pkg/helm/helm.go b/pkg/helm/helm.go
index 0cdb610..0dd5e1d 100644
--- a/pkg/helm/helm.go
+++ b/pkg/helm/helm.go
@@ -11,6 +11,7 @@ import (
 	"helm.sh/helm/v3/pkg/action"
 	"helm.sh/helm/v3/pkg/chart/loader"
 	"helm.sh/helm/v3/pkg/cli"
+	"helm.sh/helm/v3/pkg/kube"
 	"helm.sh/helm/v3/pkg/registry"
 	"helm.sh/helm/v3/pkg/release"
 	"k8s.io/cli-runtime/pkg/genericclioptions"
@@ -147,11 +148,22 @@ func (h *Helm) newAction(ctx context.Context, namespace string, allNamespaces bo
 	}
 	cfg.RegistryClient = registryClient
 	logger := klogutil.FromContext(ctx)
-	return cfg, cfg.Init(h.kubernetes, applicableNamespace, storageDriver, func(format string, v ...any) {
+	if err := cfg.Init(h.kubernetes, applicableNamespace, storageDriver, func(format string, v ...any) {
 		if logger.V(5).Enabled() {
 			logger.V(5).Info(fmt.Sprintf(format, v...))
 		}
-	})
+	}); err != nil {
+		return cfg, err
+	}
+	// Init uses the namespace only for the release storage. The Helm kube client that
+	// creates, waits for and deletes the chart's objects otherwise falls back to the
+	// kubeconfig's namespace for every object without metadata.namespace, so a chart
+	// installed with a namespace argument would land in another namespace than its
+	// release record. The Helm CLI sets the same field from --namespace.
+	if kc, ok := cfg.KubeClient.(*kube.Client); ok && applicableNamespace != "" {
+		kc.Namespace = applicableNamespace
+	}
+	return cfg, nil
 }
 
 // validateChartReference blocks chart references using dangerous URL schemes.
diff --git a/pkg/mcp/helm_test.go b/pkg/mcp/helm_test.go
index 634dac6..6535d65 100644
--- a/pkg/mcp/helm_test.go
+++ b/pkg/mcp/helm_test.go
@@ -91,6 +91,35 @@ func (s *HelmSuite) TestHelmInstall() {
 	})
 }
 
+func (s *HelmSuite) TestHelmInstallInNamespace() {
+	s.InitMcpClient()
+	kc := kubernetes.NewForConfigOrDie(test.EnvTestRestConfig())
+	_, file, _, _ := runtime.Caller(0)
+	chartPath := filepath.Join(filepath.Dir(file), "testdata", "helm-chart-secret")
+	toolResult, err := s.CallTool("helm_install", map[string]interface{}{
+		"chart":     chartPath,
+		"name":      "ns-arg-release",
+		"namespace": "ns-1",
+	})
+	s.Require().NoError(err)
+	s.Require().Falsef(toolResult.IsError, "call tool failed: %v", toolResult.Content)
+	s.Run("creates the chart's objects in the namespace argument", func() {
+		_, getErr := kc.CoreV1().Secrets("ns-1").Get(s.T().Context(), "ns-arg-release-secret", metav1.GetOptions{})
+		s.NoError(getErr)
+	})
+	s.Run("creates nothing in the kubeconfig namespace", func() {
+		_, getErr := kc.CoreV1().Secrets("default").Get(s.T().Context(), "ns-arg-release-secret", metav1.GetOptions{})
+		s.Truef(errors.IsNotFound(getErr), "chart object must not be created in the kubeconfig namespace")
+	})
+	s.Run("helm_uninstall with the namespace argument deletes the chart's objects there", func() {
+		uninstall, uninstallErr := s.CallTool("helm_uninstall", map[string]interface{}{"name": "ns-arg-release", "namespace": "ns-1"})
+		s.Require().NoError(uninstallErr)
+		s.Falsef(uninstall.IsError, "call tool failed: %v", uninstall.Content)
+		_, getErr := kc.CoreV1().Secrets("ns-1").Get(s.T().Context(), "ns-arg-release-secret", metav1.GetOptions{})
+		s.Truef(errors.IsNotFound(getErr), "chart object must be deleted from the namespace argument")
+	})
+}
+
