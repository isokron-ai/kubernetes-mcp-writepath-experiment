From 62671c47006985e95cd7a662f79292c7f978b2bb Mon Sep 17 00:00:00 2001
From: Rafe Walker <45343084+rafe-walker@users.noreply.github.com>
Date: Wed, 11 Nov 2026 11:24:53 -0700
Subject: [PATCH 02/14] fix(core): name applied and unattempted documents when
 a multi-document apply fails

resources_create_or_update applies the documents of a multi-document
manifest one by one and stopped at the first refused document. The
documents before it stayed applied, the ones after it were never sent,
and the error carried only the API's message for the refused document.
The caller could not tell what was left in place; kubectl apply, by
contrast, continues past the failed object and reports it separately.

Kubernetes has no multi-object transaction, so this change does not
roll anything back. It makes the outcome exact instead:

- Every document's kind is resolved to a resource, and its namespace
  determined, before the first write. An unknown kind or apiVersion now
  fails the call with "nothing was applied" instead of failing halfway.
  A kind defined by a CustomResourceDefinition earlier in the same input
  is resolved after that CRD has been applied, as before.
- When a write fails after others succeeded, the error is a
  PartialApplyError that names the failed document, the documents
  already applied and left in place, and the documents not attempted,
  each by position, kind, namespace and name. It wraps the API error,
  so error classification is unchanged.

Single-document calls return the same errors as before. pods_run uses
the same path and gains the same report when its Service fails after
its Pod was created.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit b535a89807277292cf54b784e78c9e17489a0f48)
---
 pkg/kubernetes/resources.go | 120 +++++++++++++++++++++++++++++++++---
 pkg/mcp/resources_test.go   |  43 +++++++++++++
 2 files changed, 154 insertions(+), 9 deletions(-)

diff --git a/pkg/kubernetes/resources.go b/pkg/kubernetes/resources.go
index e2c4dee..b005fff 100644
--- a/pkg/kubernetes/resources.go
+++ b/pkg/kubernetes/resources.go
@@ -215,26 +215,128 @@ func (c *Core) resourcesListAsTable(ctx context.Context, gvk *schema.GroupVersio
 	return &unstructured.Unstructured{Object: unstructuredObject}, err
 }
 
+// ApplyOutcome names one document of a multi-document apply.
+type ApplyOutcome struct {
+	Index     int
+	Kind      string
+	Namespace string
+	Name      string
+}
+
+func (o ApplyOutcome) String() string {
+	ref := o.Name
+	if o.Namespace != "" {
+		ref = o.Namespace + "/" + o.Name
+	}
+	return fmt.Sprintf("document %d (%s %s)", o.Index, o.Kind, ref)
+}
+
+// PartialApplyError is returned when a multi-document apply fails after some
+// documents were already applied. Kubernetes has no multi-object
+// transaction, so those stay in place; the error names them, the document
+// that failed and the documents that were never sent.
+type PartialApplyError struct {
+	Total        int
+	Applied      []ApplyOutcome
+	Failed       ApplyOutcome
+	NotAttempted []ApplyOutcome
+	Err          error
+}
+
+func (e *PartialApplyError) Error() string {
+	var b strings.Builder
+	fmt.Fprintf(&b, "%s of %d failed: %v", e.Failed, e.Total, e.Err)
+	if len(e.Applied) > 0 {
+		b.WriteString("; already applied and left in place: ")
+		b.WriteString(joinOutcomes(e.Applied))
+	}
+	if len(e.NotAttempted) > 0 {
+		b.WriteString("; not attempted: ")
+		b.WriteString(joinOutcomes(e.NotAttempted))
+	}
+	return b.String()
+}
+
+func (e *PartialApplyError) Unwrap() error { return e.Err }
+
+func joinOutcomes(outcomes []ApplyOutcome) string {
+	parts := make([]string, len(outcomes))
+	for i, o := range outcomes {
+		parts[i] = o.String()
+	}
+	return strings.Join(parts, ", ")
+}
+
 func (c *Core) resourcesCreateOrUpdate(ctx context.Context, resources []*unstructured.Unstructured) ([]*unstructured.Unstructured, error) {
+	// Resolve every document's resource and namespace before the first write, so an
+	// unknown kind or apiVersion fails the call with nothing applied. A kind defined by a
+	// CustomResourceDefinition earlier in the same input cannot resolve yet; it is
+	// resolved after that CRD has been applied.
+	gvrs := make([]*schema.GroupVersionResource, len(resources))
+	namespaces := make([]string, len(resources))
+	outcomes := make([]ApplyOutcome, len(resources))
+	crdBefore := false
+	unresolved := func(i int, err error) error {
+		if len(resources) == 1 {
+			return err
+		}
+		return fmt.Errorf("%s: %w (nothing was applied)", outcomes[i], err)
+	}
 	for i, obj := range resources {
 		gvk := obj.GroupVersionKind()
-		gvr, rErr := c.resourceFor(&gvk)
-		if rErr != nil {
-			return nil, rErr
+		outcomes[i] = ApplyOutcome{Index: i + 1, Kind: gvk.Kind, Namespace: obj.GetNamespace(), Name: obj.GetName()}
+		gvr, err := c.resourceFor(&gvk)
+		if err != nil {
+			if crdBefore && meta.IsNoMatchError(err) {
+				continue
+			}
+			return nil, unresolved(i, err)
 		}
-
 		namespace, err := c.effectiveNamespace(&gvk, obj.GetNamespace())
 		if err != nil {
-			return nil, err
+			return nil, unresolved(i, err)
+		}
+		gvrs[i], namespaces[i] = gvr, namespace
+		outcomes[i].Namespace = namespace
+		if gvk.Kind == "CustomResourceDefinition" {
+			crdBefore = true
+		}
+	}
+	partial := func(i int, err error) error {
+		if len(resources) == 1 {
+			return err
 		}
-		obj.SetNamespace(namespace)
-		resources[i], rErr = c.DynamicClient().Resource(*gvr).Namespace(namespace).Apply(ctx, obj.GetName(), obj, metav1.ApplyOptions{
+		return &PartialApplyError{
+			Total:        len(resources),
+			Applied:      outcomes[:i],
+			Failed:       outcomes[i],
+			NotAttempted: outcomes[i+1:],
+			Err:          err,
+		}
+	}
+	for i, obj := range resources {
+		gvk := obj.GroupVersionKind()
+		if gvrs[i] == nil {
+			gvr, err := c.resourceFor(&gvk)
+			if err != nil {
+				return nil, partial(i, err)
+			}
+			namespace, err := c.effectiveNamespace(&gvk, obj.GetNamespace())
+			if err != nil {
+				return nil, partial(i, err)
+			}
+			gvrs[i], namespaces[i] = gvr, namespace
+			outcomes[i].Namespace = namespace
+		}
+		obj.SetNamespace(namespaces[i])
+		applied, err := c.DynamicClient().Resource(*gvrs[i]).Namespace(namespaces[i]).Apply(ctx, obj.GetName(), obj, metav1.ApplyOptions{
 			FieldManager: version.BinaryName,
 			Force:        true,
 		})
-		if rErr != nil {
-			return nil, rErr
+		if err != nil {
+			return nil, partial(i, err)
 		}
+		resources[i] = applied
 		// Clear the cache to ensure the next operation is performed on the latest exposed APIs (will change after the CRD creation)
 		if gvk.Kind == "CustomResourceDefinition" {
 			c.RESTMapper().Reset()
diff --git a/pkg/mcp/resources_test.go b/pkg/mcp/resources_test.go
index 23f0266..8a373c8 100644
--- a/pkg/mcp/resources_test.go
+++ b/pkg/mcp/resources_test.go
@@ -1482,3 +1482,46 @@ func (s *ResourcesSuite) TestResourcesCreateOrUpdateDocumentSeparators() {
 		s.False(exists("sep-nokind-1"), "no document may be applied when one cannot be decoded")
 	})
 }
+
+func (s *ResourcesSuite) TestResourcesCreateOrUpdatePartialFailure() {
+	s.InitMcpClient()
+	client := kubernetes.NewForConfigOrDie(test.EnvTestRestConfig())
+	cm := func(name string) string {
+		return "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: " + name + "\n  namespace: default\n"
+	}
+	exists := func(name string) bool {
+		_, err := client.CoreV1().ConfigMaps("default").Get(s.T().Context(), name, metav1.GetOptions{})
+		return err == nil
+	}
+	s.Run("a document refused by the API", func() {
+		result, err := s.CallTool("resources_create_or_update", map[string]interface{}{
+			"resource": cm("partial-a") + "---\n" + cm("Partial_B") + "---\n" + cm("partial-c"),
+		})
+		s.Require().NoError(err)
+		text := result.Content[0].(*mcp.TextContent).Text
+		s.Run("returns an error", func() {
+			s.True(result.IsError)
+		})
+		s.Run("names the failed document", func() {
+			s.Contains(text, "document 2 (ConfigMap default/Partial_B) of 3 failed")
+		})
+		s.Run("names the documents already applied", func() {
+			s.Contains(text, "already applied and left in place: document 1 (ConfigMap default/partial-a)")
+			s.True(exists("partial-a"))
+		})
+		s.Run("names the documents not attempted", func() {
+			s.Contains(text, "not attempted: document 3 (ConfigMap default/partial-c)")
+			s.False(exists("partial-c"))
+		})
+	})
+	s.Run("an unknown kind fails before anything is applied", func() {
+		result, err := s.CallTool("resources_create_or_update", map[string]interface{}{
+			"resource": cm("unknown-kind-a") + "---\napiVersion: v1\nkind: NoSuchKind\nmetadata:\n  name: x\n",
+		})
+		s.Require().NoError(err)
+		s.True(result.IsError)
+		s.Contains(result.Content[0].(*mcp.TextContent).Text, "document 2 (NoSuchKind x)")
+		s.Contains(result.Content[0].(*mcp.TextContent).Text, "nothing was applied")
+		s.False(exists("unknown-kind-a"))
+	})
+}
