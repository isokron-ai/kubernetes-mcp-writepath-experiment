From e0df0784989a79bf6054947f53f4eeef9325d508 Mon Sep 17 00:00:00 2001
From: Rafe Walker <45343084+rafe-walker@users.noreply.github.com>
Date: Wed, 11 Nov 2026 11:45:17 -0700
Subject: [PATCH 12/14] fix(helm): do not report a refused release lookup as
 "not found"

helm_uninstall sets Helm's Uninstall.IgnoreNotFound so that uninstalling
a missing release succeeds with "Release <name> not found" (intended,
and asserted by TestHelmUninstallNoReleases). But Helm applies
IgnoreNotFound to every error of the release-history lookup, not only
to a missing release. When the server identity may not list the release
Secrets (RBAC, or denied_resources), the lookup failed and the tool
still answered "Release <name> not found" with success: an existing
release looked absent.

IgnoreNotFound is now off, and the server itself maps Helm's
driver.ErrReleaseNotFound to the same "Release <name> not found"
success. Any other lookup error is returned as an error. The behaviour
for a release that does not exist is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg/helm/helm.go     | 12 ++++++++++--
 pkg/mcp/helm_test.go | 16 ++++++++++++++++
 2 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/pkg/helm/helm.go b/pkg/helm/helm.go
index 0dd5e1d..15811e1 100644
--- a/pkg/helm/helm.go
+++ b/pkg/helm/helm.go
@@ -2,6 +2,7 @@ package helm
 
 import (
 	"context"
+	"errors"
 	"fmt"
 	"net/url"
 	"path"
@@ -14,6 +15,7 @@ import (
 	"helm.sh/helm/v3/pkg/kube"
 	"helm.sh/helm/v3/pkg/registry"
 	"helm.sh/helm/v3/pkg/release"
+	"helm.sh/helm/v3/pkg/storage/driver"
 	"k8s.io/cli-runtime/pkg/genericclioptions"
 	"sigs.k8s.io/yaml"
 
@@ -120,14 +122,20 @@ func (h *Helm) Uninstall(ctx context.Context, name string, namespace string) (st
 		return "", err
 	}
 	uninstall := action.NewUninstall(cfg)
-	uninstall.IgnoreNotFound = true
+	// Helm's IgnoreNotFound turns every error of the release-history lookup into
+	// "not found", including a refused list of the release Secrets (RBAC). Only a
+	// release that really does not exist is reported as not found (with success, as
+	// before); any other lookup error is returned.
+	uninstall.IgnoreNotFound = false
 	uninstall.Wait = true
 	uninstall.Timeout = 5 * time.Minute
 	uninstalledRelease, err := uninstall.Run(name)
-	if uninstalledRelease == nil && err == nil {
+	if errors.Is(err, driver.ErrReleaseNotFound) {
 		return fmt.Sprintf("Release %s not found", name), nil
 	} else if err != nil {
 		return "", err
+	} else if uninstalledRelease == nil {
+		return fmt.Sprintf("Release %s not found", name), nil
 	}
 	return fmt.Sprintf("Uninstalled release %s %s", uninstalledRelease.Release.Name, uninstalledRelease.Info), nil
 }
diff --git a/pkg/mcp/helm_test.go b/pkg/mcp/helm_test.go
index 6535d65..a9432a5 100644
--- a/pkg/mcp/helm_test.go
+++ b/pkg/mcp/helm_test.go
@@ -288,6 +288,22 @@ func (s *HelmSuite) TestHelmUninstallNoReleases() {
 	})
 }
 
+func (s *HelmSuite) TestHelmUninstallReleaseLookupDenied() {
+	configtest.OverlayTOML(s.T(), &s.Cfg, `
+		denied_resources = [ { version = "v1", kind = "Secret" } ]
+	`)
+	s.InitMcpClient()
+	toolResult, err := s.CallTool("helm_uninstall", map[string]interface{}{"name": "release-behind-denied-secrets"})
+	s.Require().NoError(err)
+	s.Run("returns an error, not \"not found\"", func() {
+		s.True(toolResult.IsError, "a refused release lookup must not be reported as a missing release")
+		s.NotContains(toolResult.Content[0].(*mcp.TextContent).Text, "Release release-behind-denied-secrets not found")
+	})
+	s.Run("names the refusal", func() {
+		s.Contains(toolResult.Content[0].(*mcp.TextContent).Text, "resource not allowed")
+	})
+}
+
 func (s *HelmSuite) TestHelmUninstall() {
 	kc := kubernetes.NewForConfigOrDie(test.EnvTestRestConfig())
 	_, err := kc.CoreV1().Secrets("default").Create(s.T().Context(), &corev1.Secret{
