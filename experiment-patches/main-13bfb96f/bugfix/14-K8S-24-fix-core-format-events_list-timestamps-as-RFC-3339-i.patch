From 4c9d247d599a902b5bfeb7e0497a115c007029b1 Mon Sep 17 00:00:00 2001
From: Rafe Walker <45343084+rafe-walker@users.noreply.github.com>
Date: Wed, 11 Nov 2026 11:47:52 -0700
Subject: [PATCH 14/14] fix(core): format events_list timestamps as RFC 3339 in
 UTC

events_list rendered each event's time with Go's time.String(), which
uses the server process's local time zone: an event at
2026-11-11T00:00:00Z was shown as "2026-11-10 17:00:00 -0700 MST" on a
host in MST. The offset makes it unambiguous, but every other time the
server returns, and the API itself, uses RFC 3339 in UTC, and the agent
has to convert. On a UTC host (the container image) the text was
"... +0000 UTC", also not RFC 3339.

Timestamps are now `time.UTC().Format(time.RFC3339)`. The existing
events tests asserted the old rendering of the zero time
("0001-01-01 00:00:00 +0000 UTC"); they now expect
"0001-01-01T00:00:00Z", the same instant in the new format.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg/kubernetes/events.go |  4 +++-
 pkg/mcp/events_test.go   | 30 ++++++++++++++++++++++++++----
 2 files changed, 29 insertions(+), 5 deletions(-)

diff --git a/pkg/kubernetes/events.go b/pkg/kubernetes/events.go
index b7a5049..7066524 100644
--- a/pkg/kubernetes/events.go
+++ b/pkg/kubernetes/events.go
@@ -3,6 +3,7 @@ package kubernetes
 import (
 	"context"
 	"strings"
+	"time"
 
 	"github.com/containers/kubernetes-mcp-server/pkg/api"
 	v1 "k8s.io/api/core/v1"
@@ -40,7 +41,8 @@ func (c *Core) EventsList(ctx context.Context, namespace string, options api.Lis
 		}
 		eventMap = append(eventMap, map[string]any{
 			"Namespace": event.Namespace,
-			"Timestamp": timestamp.String(),
+			// RFC 3339 in UTC, like every other timestamp the server returns (time.String() used the host's zone)
+			"Timestamp": timestamp.UTC().Format(time.RFC3339),
 			"Type":      event.Type,
 			"Reason":    event.Reason,
 			"InvolvedObject": map[string]string{
diff --git a/pkg/mcp/events_test.go b/pkg/mcp/events_test.go
index c0a6c72..9ea7ba0 100644
--- a/pkg/mcp/events_test.go
+++ b/pkg/mcp/events_test.go
@@ -101,7 +101,7 @@ func (s *EventsSuite) TestEventsList() {
 					"  Message: The event message\n"+
 					"  Namespace: ns-1\n"+
 					"  Reason: \"\"\n"+
-					"  Timestamp: 0001-01-01 00:00:00 +0000 UTC\n"+
+					"  Timestamp: \"0001-01-01T00:00:00Z\"\n"+
 					"  Type: Normal\n",
 					toolResult.Content[0].(*mcp.TextContent).Text,
 					"unexpected result %v", toolResult.Content[0].(*mcp.TextContent).Text)
@@ -110,6 +110,28 @@ func (s *EventsSuite) TestEventsList() {
 	})
 }
 
+func (s *EventsSuite) TestEventsListTimestampsAreRFC3339UTC() {
+	s.InitMcpClient()
+	client := kubernetes.NewForConfigOrDie(test.EnvTestRestConfig())
+	ns, err := client.CoreV1().Namespaces().Create(s.T().Context(), &v1.Namespace{
+		ObjectMeta: metav1.ObjectMeta{GenerateName: "events-time-"},
+	}, metav1.CreateOptions{})
+	s.Require().NoError(err)
+	at := time.Date(2026, 11, 11, 0, 0, 0, 0, time.UTC)
+	_, err = client.CoreV1().Events(ns.Name).Create(s.T().Context(), &v1.Event{
+		ObjectMeta:     metav1.ObjectMeta{Name: "a-timed-event"},
+		InvolvedObject: v1.ObjectReference{APIVersion: "v1", Kind: "Pod", Name: "a-pod", Namespace: ns.Name},
+		Type:           "Normal",
+		Message:        "timed",
+		FirstTimestamp: metav1.NewTime(at.In(time.FixedZone("MST", -7*3600))),
+	}, metav1.CreateOptions{})
+	s.Require().NoError(err)
+	toolResult, err := s.CallTool("events_list", map[string]interface{}{"namespace": ns.Name})
+	s.Require().NoError(err)
+	s.Require().Falsef(toolResult.IsError, "call tool failed: %v", toolResult.Content)
+	s.Contains(toolResult.Content[0].(*mcp.TextContent).Text, "Timestamp: \"2026-11-11T00:00:00Z\"")
+}
+
 func (s *EventsSuite) TestEventsListDenied() {
 	configtest.OverlayTOML(s.T(), &s.Cfg, `
 		denied_resources = [ { version = "v1", kind = "Event" } ]
@@ -240,7 +262,7 @@ func (s *EventsSuite) TestEventsListWithFieldSelector() {
 				"  Message: Started container successfully\n"+
 				"  Namespace: default\n"+
 				"  Reason: Started\n"+
-				"  Timestamp: 0001-01-01 00:00:00 +0000 UTC\n"+
+				"  Timestamp: \"0001-01-01T00:00:00Z\"\n"+
 				"  Type: Normal\n",
 				toolResult.Content[0].(*mcp.TextContent).Text,
 				"unexpected result %v", toolResult.Content[0].(*mcp.TextContent).Text)
@@ -370,7 +392,7 @@ func createdEvent(namespace string) map[string]any {
 		"Message":   "The event message",
 		"Namespace": namespace,
 		"Reason":    "",
-		"Timestamp": "0001-01-01 00:00:00 +0000 UTC",
+		"Timestamp": "0001-01-01T00:00:00Z",
 		"Type":      "Normal",
 	}
 }
@@ -385,7 +407,7 @@ func crashingPodWarning() map[string]any {
 		"Message":   "Back-off restarting failed container",
 		"Namespace": "default",
 		"Reason":    "BackOff",
-		"Timestamp": "0001-01-01 00:00:00 +0000 UTC",
+		"Timestamp": "0001-01-01T00:00:00Z",
 		"Type":      "Warning",
 	}
 }
