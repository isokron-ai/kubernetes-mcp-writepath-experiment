+// validateToolNames refuses enabled_tools, opt_in_tools and disabled_tools entries that
+// name no tool of any toolset this server provides. A misspelt name otherwise starts the
+// server with no tools (enabled_tools) or with the tool the operator meant to hide
+// (disabled_tools). A tool of a toolset that is not enabled is a valid name (it is simply
+// not served). It runs at start and on configuration reload, not when cluster state
+// changes, so a tool that a toolset offers only on some clusters cannot stop a running server.
+func (s *Server) validateToolNames(ctx context.Context, cfg *Configuration) error {
+	enabled, optIn, disabled := cfg.EnabledTools.Get(), cfg.OptInTools.Get(), cfg.DisabledTools.Get()
+	if len(enabled) == 0 && len(optIn) == 0 && len(disabled) == 0 {
+		return nil
+	}
+	known := map[string]bool{}
+	rename := WithTargetListTool(s.p.GetDefaultTarget(), s.p.GetTargetParameterName(), s.p)
+	toolsetContext := s.toolsetContext(cfg)
+	for _, toolset := range toolsets.Toolsets() {
+		for _, tool := range toolset.GetTools(ctx, toolsetContext) {
+			known[tool.Tool.Name] = true
+			known[rename(tool).Tool.Name] = true
+		}
+	}
+	var errs []error
+	for _, option := range []struct {
+		name  string
+		names []string
+	}{{"enabled_tools", enabled}, {"opt_in_tools", optIn}, {"disabled_tools", disabled}} {
+		var unknown []string
+		for _, name := range option.names {
+			if !known[name] {
+				unknown = append(unknown, name)
+			}
+		}
+		if len(unknown) > 0 {
+			errs = append(errs, fmt.Errorf("%s names tools that no toolset provides: %s (toolsets: %s)",
+				option.name, strings.Join(unknown, ", "), strings.Join(toolsets.ToolsetNames(), ", ")))
+		}
+	}
+	return errors.Join(errs...)
+}
