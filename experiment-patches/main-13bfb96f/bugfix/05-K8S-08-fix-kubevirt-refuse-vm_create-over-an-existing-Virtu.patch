 pkg/mcp/kubevirt_test.go                      | 24 +++++++++++++++++++
 pkg/mcp/testdata/toolsets-kubevirt-tools.json |  1 +
 pkg/toolsets/kubevirt/vm/create/tool.go       | 18 +++++++++++++-
