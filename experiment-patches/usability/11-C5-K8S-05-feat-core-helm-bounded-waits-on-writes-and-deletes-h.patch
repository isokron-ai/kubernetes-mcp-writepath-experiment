@@ -37,7 +37,25 @@ func NewHelm(kubernetes Kubernetes, config *Config) *Helm {
 	return &Helm{kubernetes: kubernetes, config: config}
 }
 
+// InstallOptions are helm_install's waiting and failure options. The zero value is the
+// historical behaviour: wait 5 minutes for every object to be ready, no rollback.
+// Upstream #1334 proposes the same wait and timeout as toolset-level defaults.
+type InstallOptions struct {
+	// NoWait returns as soon as the objects are created (helm install without --wait).
+	NoWait bool
+	// Timeout of the wait and of hooks; 0 means 5 minutes.
+	Timeout time.Duration
+	// RollbackOnFailure uninstalls the release if the install fails or times out
+	// (helm install --atomic), so the name is free for a retry. It implies waiting.
+	RollbackOnFailure bool
+}
+
 func (h *Helm) Install(ctx context.Context, chart string, values map[string]interface{}, name string, namespace string) (string, error) {
+	return h.InstallWithOptions(ctx, chart, values, name, namespace, InstallOptions{})
+}
+
+// InstallWithOptions installs a chart with explicit wait, timeout and rollback options.
+func (h *Helm) InstallWithOptions(ctx context.Context, chart string, values map[string]interface{}, name string, namespace string, opts InstallOptions) (string, error) {
 	if err := validateChartReference(chart, h.config); err != nil {
 		return "", err
 	}
@@ -53,8 +71,12 @@ func (h *Helm) Install(ctx context.Context, chart string, values map[string]inte
 		install.ReleaseName = name
 	}
 	install.Namespace = h.kubernetes.NamespaceOrDefault(namespace)
-	install.Wait = true
+	install.Wait = !opts.NoWait || opts.RollbackOnFailure
 	install.Timeout = 5 * time.Minute
+	if opts.Timeout > 0 {
+		install.Timeout = opts.Timeout
+	}
+	install.Atomic = opts.RollbackOnFailure
 	install.DryRun = false
 
 	chartRequested, err := install.LocateChart(chart, cli.New())
@@ -68,7 +90,7 @@ func (h *Helm) Install(ctx context.Context, chart string, values map[string]inte
 
 	installedRelease, err := install.RunWithContext(ctx, chartLoaded, values)
 	if err != nil {
-		return "", err
+		return "", h.withReleaseState(ctx, install.ReleaseName, install.Namespace, err)
 	}
 	ret, err := yaml.Marshal(simplify(installedRelease))
 	if err != nil {
@@ -116,7 +138,29 @@ func helmPageNote(limit, offset, count int) string {
 	return ""
 }
 
+// withReleaseState adds the state the failed operation left the release in, so the
+// caller knows whether the name is still taken and what to do next.
+func (h *Helm) withReleaseState(ctx context.Context, name, namespace string, err error) error {
+	if name == "" {
+		return err
+	}
+	cfg, cfgErr := h.newAction(ctx, namespace, false)
+	if cfgErr != nil {
+		return err
+	}
+	rel, statusErr := action.NewStatus(cfg).Run(name)
+	if statusErr != nil || rel == nil || rel.Info == nil {
+		return err
+	}
+	return fmt.Errorf("%w (release %s is now in state %q in namespace %s; its objects may remain: helm_uninstall it before reusing the name, or retry with rollback_on_failure)", err, name, rel.Info.Status.String(), namespace)
+}
+
 func (h *Helm) Uninstall(ctx context.Context, name string, namespace string) (string, error) {
+	return h.UninstallWithOptions(ctx, name, namespace, InstallOptions{})
+}
+
+// UninstallWithOptions uninstalls a release; NoWait and Timeout apply to the wait for its objects to be deleted.
+func (h *Helm) UninstallWithOptions(ctx context.Context, name string, namespace string, opts InstallOptions) (string, error) {
 	cfg, err := h.newAction(ctx, h.kubernetes.NamespaceOrDefault(namespace), false)
 	if err != nil {
 		return "", err
@@ -127,8 +171,11 @@ func (h *Helm) Uninstall(ctx context.Context, name string, namespace string) (st
 	// release that really does not exist is reported as not found (with success, as
 	// before); any other lookup error is returned.
 	uninstall.IgnoreNotFound = false
-	uninstall.Wait = true
+	uninstall.Wait = !opts.NoWait
 	uninstall.Timeout = 5 * time.Minute
+	if opts.Timeout > 0 {
+		uninstall.Timeout = opts.Timeout
+	}
 	uninstalledRelease, err := uninstall.Run(name)
 	if errors.Is(err, driver.ErrReleaseNotFound) {
 		return fmt.Sprintf("Release %s not found", name), nil
diff --git a/pkg/kubernetes/wait.go b/pkg/kubernetes/wait.go
new file mode 100644
index 0000000..06ffa0b
--- /dev/null
+++ b/pkg/kubernetes/wait.go
@@ -0,0 +1,105 @@
+package kubernetes
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+)
+
+// MaxWait bounds every wait, below the request timeouts MCP clients commonly use.
+const MaxWait = 120 * time.Second
+
+// WaitPollInterval is how often a wait re-reads the object.
+var WaitPollInterval = time.Second
+
+// Readiness says whether obj has reached the state a caller waits for after a write:
+// a workload's rollout is complete, a Pod is Ready, a Job is Complete. Any other kind
+// is ready once it exists.
+func Readiness(obj *unstructured.Unstructured) (bool, string) {
+	switch obj.GetKind() {
+	case "Deployment", "StatefulSet", "DaemonSet":
+		st := rolloutStatus(obj)
+		return st.Complete, fmt.Sprintf("%d/%d updated, %d ready, %d available", st.UpdatedReplicas, st.Replicas, st.ReadyReplicas, st.AvailableReplicas)
+	case "Pod":
+		phase, _, _ := unstructured.NestedString(obj.Object, "status", "phase")
+		if phase == "Succeeded" {
+			return true, "Succeeded"
+		}
+		return conditionTrue(obj, "Ready"), "phase " + phase
+	case "Job":
+		if conditionTrue(obj, "Failed") {
+			return true, "Failed"
+		}
+		return conditionTrue(obj, "Complete"), "not complete"
+	}
+	return true, "exists"
+}
+
+func conditionTrue(obj *unstructured.Unstructured, conditionType string) bool {
+	conditions, _, _ := unstructured.NestedSlice(obj.Object, "status", "conditions")
+	for _, c := range conditions {
+		m, _ := c.(map[string]any)
+		if m["type"] == conditionType && m["status"] == "True" {
+			return true
+		}
+	}
+	return false
+}
+
+// WaitFor re-reads an object until it is ready (gone == false) or gone (gone == true),
+// or until timeout. It returns whether the state was reached and the last state seen.
+func (c *Core) WaitFor(ctx context.Context, gvk *schema.GroupVersionKind, namespace, name string, gone bool, timeout time.Duration) (bool, string, error) {
+	if timeout > MaxWait {
+		timeout = MaxWait
+	}
+	gvr, err := c.resourceFor(gvk)
+	if err != nil {
+		return false, "", err
+	}
+	namespace, err = c.effectiveNamespace(gvk, namespace)
+	if err != nil {
+		return false, "", err
+	}
+	client := c.DynamicClient().Resource(*gvr).Namespace(namespace)
+	deadline := time.Now().Add(timeout)
+	state := ""
+	for {
+		obj, err := client.Get(ctx, name, metav1.GetOptions{})
+		switch {
+		case apierrors.IsNotFound(err):
+			if gone {
+				return true, "gone", nil
+			}
+			state = "not found"
+		case err != nil:
+			return false, state, err
+		case gone:
+			state = "still exists"
+			if obj.GetDeletionTimestamp() != nil {
+				state = "terminating"
+				if f := obj.GetFinalizers(); len(f) > 0 {
+					state = fmt.Sprintf("held by finalizers %v", f)
+				}
+			}
+		default:
+			var ready bool
+			ready, state = Readiness(obj)
+			if ready {
+				return true, state, nil
+			}
+		}
+		if time.Now().Add(WaitPollInterval).After(deadline) {
+			return false, state, nil
+		}
+		select {
+		case <-ctx.Done():
+			return false, state, ctx.Err()
+		case <-time.After(WaitPollInterval):
+		}
+	}
+}
diff --git a/pkg/mcp/helm_test.go b/pkg/mcp/helm_test.go
index a9432a5..5051ceb 100644
--- a/pkg/mcp/helm_test.go
+++ b/pkg/mcp/helm_test.go
@@ -120,6 +120,50 @@ func (s *HelmSuite) TestHelmInstallInNamespace() {
 	})
 }
 
+func (s *HelmSuite) TestHelmInstallWaitOptions() {
+	s.InitMcpClient()
+	kc := kubernetes.NewForConfigOrDie(test.EnvTestRestConfig())
+	ns, err := kc.CoreV1().Namespaces().Create(s.T().Context(), &corev1.Namespace{ObjectMeta: metav1.ObjectMeta{GenerateName: "helm-wait-"}}, metav1.CreateOptions{})
+	s.Require().NoError(err)
+	defer func() {
+		// envtest runs no namespace controller: remove the release records explicitly
+		_ = kc.CoreV1().Secrets(ns.Name).DeleteCollection(context.Background(), metav1.DeleteOptions{}, metav1.ListOptions{LabelSelector: "owner=helm"})
+		_ = kc.CoreV1().Namespaces().Delete(context.Background(), ns.Name, metav1.DeleteOptions{})
+	}()
+	_, file, _, _ := runtime.Caller(0)
+	chartPath := filepath.Join(filepath.Dir(file), "testdata", "helm-chart-never-ready")
+	s.Run("wait: false returns once the objects are created", func() {
+		result, err := s.CallTool("helm_install", map[string]interface{}{"chart": chartPath, "name": "no-wait", "namespace": ns.Name, "wait": false})
+		s.Require().NoError(err)
+		s.Falsef(result.IsError, "call tool failed: %v", result.Content)
+		_, getErr := kc.AppsV1().Deployments(ns.Name).Get(s.T().Context(), "no-wait-stuck", metav1.GetOptions{})
+		s.NoError(getErr)
+	})
+	s.Run("a timeout with rollback_on_failure leaves nothing behind", func() {
+		result, err := s.CallTool("helm_install", map[string]interface{}{
+			"chart": chartPath, "name": "atomic", "namespace": ns.Name, "timeout": "2s", "rollback_on_failure": true,
+		})
+		s.Require().NoError(err)
+		s.True(result.IsError)
+		_, getErr := kc.AppsV1().Deployments(ns.Name).Get(s.T().Context(), "atomic-stuck", metav1.GetOptions{})
+		s.Truef(errors.IsNotFound(getErr), "the release's objects must be removed")
+		secrets, listErr := kc.CoreV1().Secrets(ns.Name).List(s.T().Context(), metav1.ListOptions{LabelSelector: "owner=helm,name=atomic"})
+		s.Require().NoError(listErr)
+		s.Empty(secrets.Items, "no release record may remain")
+	})
+	s.Run("a timeout without rollback names the release state", func() {
+		result, err := s.CallTool("helm_install", map[string]interface{}{"chart": chartPath, "name": "stuck", "namespace": ns.Name, "timeout": "2s"})
+		s.Require().NoError(err)
+		s.True(result.IsError)
+		s.Contains(result.Content[0].(*mcp.TextContent).Text, "release stuck is now in state \"failed\" in namespace "+ns.Name)
+	})
+	s.Run("an invalid timeout is refused", func() {
+		result, err := s.CallTool("helm_install", map[string]interface{}{"chart": chartPath, "name": "bad-timeout", "timeout": "four minutes"})
+		s.Require().NoError(err)
+		s.True(result.IsError)
+	})
+}
+
 func (s *HelmSuite) TestHelmInstallDenied() {
 	configtest.OverlayTOML(s.T(), &s.Cfg, `
 		denied_resources = [ { version = "v1", kind = "Secret" } ]
diff --git a/pkg/mcp/resources_test.go b/pkg/mcp/resources_test.go
index f19b689..f39f2ef 100644
--- a/pkg/mcp/resources_test.go
+++ b/pkg/mcp/resources_test.go
@@ -1576,6 +1576,34 @@ func (s *ResourcesSuite) TestResourcesDeleteTellsTheTruth() {
 	})
 }
 
+func (s *ResourcesSuite) TestResourcesWait() {
+	s.InitMcpClient()
+	s.Run("create_or_update waits for a ConfigMap to exist", func() {
+		result, err := s.CallTool("resources_create_or_update", map[string]interface{}{
+			"resource": "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: cm-waited\n  namespace: default\n", "wait": 5,
+		})
+		s.Require().NoError(err)
+		s.Require().Falsef(result.IsError, "call tool failed: %v", result.Content)
+		s.Contains(result.Content[0].(*mcp.TextContent).Text, "# wait: ConfigMap default/cm-waited is ready (exists)")
+	})
+	s.Run("a Deployment that never becomes ready is reported, not failed", func() {
+		result, err := s.CallTool("resources_create_or_update", map[string]interface{}{
+			"resource": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: never-ready\n  namespace: default\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: nr\n  template:\n    metadata:\n      labels:\n        app: nr\n    spec:\n      containers:\n      - name: c\n        image: nginx\n",
+			"wait":     1,
+		})
+		s.Require().NoError(err)
+		s.Require().Falsef(result.IsError, "call tool failed: %v", result.Content)
+		s.Contains(result.Content[0].(*mcp.TextContent).Text, "# wait: Deployment default/never-ready is NOT ready yet after the wait (0/1 updated")
+	})
+	s.Run("a wait above the maximum is refused", func() {
+		result, err := s.CallTool("resources_create_or_update", map[string]interface{}{
+			"resource": "apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: cm-not-waited\n  namespace: default\n", "wait": 600,
+		})
+		s.Require().NoError(err)
+		s.True(result.IsError)
+	})
+}
+
 func TestResources(t *testing.T) {
 	suite.Run(t, new(ResourcesSuite))
 }
