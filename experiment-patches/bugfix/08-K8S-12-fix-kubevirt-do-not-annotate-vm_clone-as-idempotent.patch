From e4d0adc5fd09642e50afbdc068d2d2842c6c1f6f Mon Sep 17 00:00:00 2001
From: Rafe Walker <45343084+rafe-walker@users.noreply.github.com>
Date: Wed, 11 Nov 2026 11:33:46 -0700
Subject: [PATCH 08/14] fix(kubevirt): do not annotate vm_clone as idempotent

vm_clone creates a VirtualMachineClone with metadata.generateName, so
each call creates another clone request: two identical calls gave two
VirtualMachineClone objects. The tool was annotated idempotentHint
true, which tells clients a retry is safe. The annotation block matches
vm_create's and appears to have been copied.

The hint is now false. The snapshot of the kubevirt tool catalog changes
accordingly.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg/mcp/kubevirt_test.go                      | 13 +++++++++++++
 pkg/mcp/testdata/toolsets-kubevirt-tools.json |  2 +-
 pkg/toolsets/kubevirt/vm/clone/tool.go        |  5 +++--
 3 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/pkg/mcp/kubevirt_test.go b/pkg/mcp/kubevirt_test.go
index 0225753..ea744b4 100644
--- a/pkg/mcp/kubevirt_test.go
+++ b/pkg/mcp/kubevirt_test.go
@@ -797,6 +797,19 @@ func (s *KubevirtSuite) TestVMClone() {
 
 }
 
+func (s *KubevirtSuite) TestVMCloneIsNotIdempotent() {
+	tools, err := s.ListTools()
+	s.Require().NoError(err)
+	for _, tool := range tools.Tools {
+		if tool.Name == "vm_clone" {
+			s.Require().NotNil(tool.Annotations)
+			s.False(tool.Annotations.IdempotentHint, "every vm_clone call creates a new VirtualMachineClone")
+			return
+		}
+	}
+	s.Fail("vm_clone not listed")
+}
+
